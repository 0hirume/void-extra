# Template file for 'mitos-nightly'
pkgname=mitos-nightly
version=20260928
revision=1
commit=e57992d43a8815b92c007885d819bad9d0a76e56
wrksrc="${pkgname}-${version}"
build_style=cargo
hostmakedepends="git"
replaces="mitos>=0"
short_desc="Modal terminal text editor"
maintainer="ohirume <0uhirume@gmail.com>"
license="MPL-2.0"
homepage="https://github.com/mitos-editor/mitos"

do_fetch() {
	git init "$wrksrc"
	git -C "$wrksrc" remote add origin https://github.com/mitos-editor/mitos.git
	git -C "$wrksrc" fetch --depth 1 origin "$commit"
	git -C "$wrksrc" checkout --detach FETCH_HEAD
	cd "$wrksrc"
	cargo run --locked --package loader --bin loader
}

# The build checks fetched grammar repositories with Git.
export PATH="$PATH:/usr/libexec/chroot-git"
export MITOS_DEFAULT_RUNTIME=/usr/lib/mitos/runtime

do_install() {
	vbin target/${RUST_TARGET}/release/ms
}

post_install() {
	rm -rf runtime/grammars/sources

	for shell in bash zsh fish; do
		vcompletion contrib/completion/ms.${shell} ${shell} ms
	done

	vmkdir usr/lib/mitos
	vcopy runtime usr/lib/mitos
}
