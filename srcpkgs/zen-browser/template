# Template file for 'zen-browser'
pkgname=zen-browser
version=1.22.3b
revision=1
archs="x86_64"
build_style=fetch
depends="gtk+3 libXt nss dbus-glib libpulseaudio alsa-lib"
short_desc="Privacy-focused web browser"
maintainer="ohirume <0uhirume@gmail.com>"
license="MPL-2.0"
homepage="https://zen-browser.app/"
distfiles="https://github.com/zen-browser/desktop/releases/download/${version}/zen.linux-x86_64.tar.xz"
checksum=0aaee1b3f67f074aebf7fc6c2fe824441bcafd431e9991336479c16370519dd0
nostrip=yes

do_extract() {
	vsrcextract zen.linux-x86_64.tar.xz
}

do_install() {
	vmkdir usr/lib/zen-browser
	vcopy . usr/lib/zen-browser

	vmkdir usr/bin
	ln -sf /usr/lib/zen-browser/zen "${DESTDIR}/usr/bin/zen-browser"

	vinstall "${FILESDIR}/zen-browser.desktop" 644 usr/share/applications

	for size in 16 32 48 64 128; do
		vinstall "browser/chrome/icons/default/default${size}.png" \
			644 \
			"usr/share/icons/hicolor/${size}x${size}/apps" \
			zen-browser.png
	done
}
